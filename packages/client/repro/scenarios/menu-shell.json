{
  "name": "Main menu shell: keyboard + every screen",
  "description": "The front menu is keyboard-first and every entry opens its screen: presence line, Ranked, Private match, Leaderboards (live API, empty board), Profile (no pilot yet), Settings, and Esc back to main.",
  "steps": [
    { "do": "waitFor", "until": "p.menu === 'main'", "timeoutMs": 60000 },
    { "do": "waitFor", "until": "!!document.querySelector('.presence:not(.hidden)') && /pilots? online/.test(document.querySelector('.presence').textContent)", "timeoutMs": 30000 },
    { "do": "expect", "that": "document.activeElement?.textContent.startsWith('Quick Match')", "label": "Quick Match has focus" },
    { "do": "screenshot", "name": "main" },
    { "do": "press", "key": "ArrowDown" },
    { "do": "expect", "that": "document.activeElement?.textContent.startsWith('Ranked')", "label": "↓ moves to Ranked" },
    { "do": "press", "key": "Enter" },
    { "do": "waitFor", "until": "p.menu === 'ranked' && document.querySelectorAll('.ranks span').length === 9", "timeoutMs": 5000 },
    { "do": "press", "key": "Escape" },
    { "do": "waitFor", "until": "p.menu === 'main'", "timeoutMs": 5000 },
    { "do": "click", "text": "Private match" },
    { "do": "waitFor", "until": "p.menu === 'private' && !!document.querySelector('input[placeholder=\"Room code\"]')", "timeoutMs": 5000 },
    { "do": "click", "text": "Back" },
    { "do": "click", "text": "Leaderboards" },
    { "do": "waitFor", "until": "p.menu === 'leaderboards' && /No finished matches/.test(document.querySelector('.board').textContent)", "timeoutMs": 10000 },
    { "do": "waitFor", "until": "/daily challenge: (Survival|Score Attack|Mine Run)/.test(document.querySelector('.daily').textContent)", "timeoutMs": 10000 },
    { "do": "click", "text": "All time" },
    { "do": "waitFor", "until": "p.menu === 'leaderboards' && document.querySelector('.tabs .on')?.textContent === 'All time'", "timeoutMs": 5000 },
    { "do": "screenshot", "name": "leaderboards" },
    { "do": "click", "text": "Back" },
    { "do": "click", "text": "Profile" },
    { "do": "waitFor", "until": "p.menu === 'profile' && /first online match|Fly one online match/.test(document.querySelector('.profile').textContent)", "timeoutMs": 10000 },
    { "do": "screenshot", "name": "profile" },
    { "do": "press", "key": "Escape" },
    { "do": "click", "text": "Settings" },
    { "do": "waitFor", "until": "p.menu === 'settings'", "timeoutMs": 5000 },
    { "do": "press", "key": "Escape" },
    { "do": "waitFor", "until": "p.menu === 'main'", "timeoutMs": 5000 },
    { "do": "noErrors" }
  ]
}
